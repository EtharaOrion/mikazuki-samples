  {
    "id": "4003",
    "author_id": "3003",
    "text": "Rehearsal day. Four hours on the new arrangement with @jessicawebbsax. Hands are tired but the bridge finally clicks.",
    "created_at": "2026-02-18T20:45:00.000Z",
    "lang": "en",
    "reply_to_tweet_id": "100000",
    "like_count": 148,

[
  {
    "id": "fw0001aaaa",
    "zone_id": "zone1aaaa1111bbbb2222cccc3333dddd",
    "description": "Block known bad bots",
    "action": "block",
    "expression": "(cf.client.bot and not cf.verified_bot_category eq \"\")",
    "paused": "false",
    "priority": "1",
    "created_on": "2025-01-15T10:00:00.000Z"
  },
  {
    "id": "fw0002aaaa",
    "zone_id": "zone1aaaa1111bbbb2222cccc3333dddd",
    "description": "Challenge non-US traffic on the reservations endpoint",
    "action": "managed_challenge",
    "expression": "(http.request.uri.path contains \"/reservations\" and ip.geoip.country ne \"US\")",
    "paused": "false",
    "priority": "2",
    "created_on": "2025-01-15T10:00:00.000Z"
  },
  {
    "id": "fw0003aaaa",
    "zone_id": "zone1aaaa1111bbbb2222cccc3333dddd",
